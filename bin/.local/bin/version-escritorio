#!/usr/bin/env bash
# version-escritorio: cambia entre las versiones del escritorio (ramas del repositorio dotfiles).
#   version-escritorio            -> lista las versiones y marca la actual
#   version-escritorio <versión>  -> cambia a esa versión y la aplica al momento
# Cada versión declara su fondo y sus widgets en noctalia/.config/noctalia/version.toml.
#
# Todo va dentro de main(): bash lee la función entera antes de ejecutarla, así que no le afecta
# que este mismo archivo cambie al hacer git switch.

set -euo pipefail

REPO="$HOME/dev/projects/personal/dotfiles"
PACKAGES=(hypr noctalia kitty uwsm qt6ct menus swash energia bin brave)

SETTINGS="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/settings.toml"

# Borra de settings.toml (lo que Noctalia guarda desde su interfaz, que manda sobre la configuración)
# las tablas [desktop_widgets...] y [wallpaper...], para que valgan las de la versión nueva.
# Deja una copia en settings.toml.bak.
quitar_ajustes_guardados() {
    [[ -f "$SETTINGS" ]] || return 0
    cp "$SETTINGS" "$SETTINGS.bak"
    awk '
        /^[[:space:]]*\[/ { h = $0; sub(/^[[:space:]]*\[+/, "", h); skip = (h ~ /^(desktop_widgets|wallpaper)([].]|$)/) }
        !skip
    ' "$SETTINGS.bak" > "$SETTINGS"
}

# Reinicia Noctalia. Un "noctalia msg config-reload" no basta: si la versión cambia el espacio
# reservado de las pantallas, Hyprland las reconfigura y Noctalia pierde el fondo y los widgets.
# Los ajustes guardados se borran con Noctalia ya cerrado (al cerrarse vuelve a guardar los suyos).
# Se lanza a través de Hyprland, como al iniciar sesión, y se respeta si la cafeína estaba activa.
reiniciar_noctalia() {
    local cafeina=false inhibidores
    inhibidores=$(systemd-inhibit --list --no-pager 2>/dev/null || true)
    [[ $inhibidores == *Caffeine* ]] && cafeina=true

    pkill -x noctalia || true
    for _ in {1..40}; do pgrep -x noctalia >/dev/null || break; sleep 0.25; done

    quitar_ajustes_guardados

    hyprctl dispatch 'hl.dsp.exec_cmd("noctalia")' >/dev/null
    for _ in {1..40}; do noctalia msg wallpaper-get >/dev/null 2>&1 && break; sleep 0.25; done

    if $cafeina; then
        noctalia msg caffeine-enable >/dev/null
    fi
}

main() {
    cd "$REPO"

    if [[ $# -eq 0 ]]; then
        echo "Versiones (la actual va marcada con *):"
        git branch
        return 0
    fi

    if [[ -n "$(git status --porcelain)" ]]; then
        echo "Hay cambios sin guardar en $REPO:"
        git status --short
        echo "Guárdalos (git add -A && git commit -m \"...\") antes de cambiar de versión."
        return 1
    fi

    if ! git rev-parse --verify --quiet "refs/heads/$1" >/dev/null; then
        echo "No existe la versión '$1'. Las que hay:"
        git branch
        return 1
    fi

    # Quitar los enlaces de la versión actual ANTES de cambiar (si no, los archivos que solo existen
    # en ella quedarían como enlaces rotos), cambiar de rama y enlazar la nueva.
    stow --no-folding -D -t "$HOME" "${PACKAGES[@]}"
    git switch "$1"
    stow --no-folding -t "$HOME" "${PACKAGES[@]}"

    hyprctl reload >/dev/null

    # Si colocaste widgets con el editor o elegiste otro fondo y quieres conservarlos, pásalos antes
    # al version.toml de la rama: al reiniciar Noctalia se borran para que manden los de la versión.
    reiniciar_noctalia

    echo "Versión '$1' aplicada."
}

main "$@"
exit
