#!/usr/bin/env bash
# al80-layout: cambia la distribución de teclado de KDE según esté conectado el YUNZII AL80.
#   AL80 conectado (cable o Bluetooth) -> "us": English (intl., with AltGr dead keys)
#   AL80 desconectado                  -> "es": el teclado español del portátil
# Solo actúa cuando el AL80 aparece o desaparece, así que un cambio manual (Meta+Alt+K) se respeta.
# Lo arranca el servicio de usuario al80-layout.service:
#   systemctl --user status al80-layout      journalctl --user -u al80-layout

set -u

NAME_PATTERN='AL80'      # por cable: "SmartCloud AL80 Keyboard"; por Bluetooth: "YUNZII AL80 BT1"
LAYOUT_CONNECTED='us'    # nombre corto de la distribución (Configuración del sistema > Teclado)
LAYOUT_DISCONNECTED='es'

# Interfaz de distribuciones de KWin por D-Bus (getLayoutsList, setLayout...)
kbd() {
    busctl --user --json=short call org.kde.keyboard /Layouts org.kde.KeyboardLayouts "$@"
}

state() {
    if grep -qs -- "$NAME_PATTERN" /sys/class/input/input*/name; then
        echo connected
    else
        echo disconnected
    fi
}

apply() {  # $1 = connected | disconnected
    local layout idx
    if [[ $1 == connected ]]; then
        layout=$LAYOUT_CONNECTED
    else
        layout=$LAYOUT_DISCONNECTED
    fi
    # getLayoutsList devuelve {"data":[[["us","","English (intl., with AltGr dead keys)"],["es","","Spanish"]]]}
    if ! idx=$(kbd getLayoutsList | jq -e --arg l "$layout" '.data[0] | map(.[0]) | index($l)'); then
        echo "No encuentro la distribución '$layout' en KDE" >&2
        return 1
    fi
    kbd setLayout u "$idx" >/dev/null && echo "AL80 $1 -> $layout"
}

# Al iniciar sesión, KWin puede tardar un poco en publicar la interfaz
for _ in {1..30}; do
    busctl --user status org.kde.keyboard &>/dev/null && break
    sleep 1
done

last=$(state)
apply "$last"
# KWin puede restaurar la distribución de la sesión anterior justo después del login: reaplicamos una vez
(sleep 10; apply "$(state)") &

# udevadm monitor escribe una línea por cada evento del subsistema input (teclados, ratones...).
# Tras cada una miramos si el AL80 sigue ahí y solo cambiamos si ha aparecido o desaparecido.
stdbuf -oL udevadm monitor --udev --subsystem-match=input | while read -r _; do
    now=$(state)
    if [[ $now != "$last" ]] && apply "$now"; then
        last=$now
    fi
done
